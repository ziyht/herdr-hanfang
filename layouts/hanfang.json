{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.16"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome-zh"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "better-sidebar",
                "props": {
                  "view": "lists"
                }
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "better-sidebar",
                "props": {
                  "view": "agents"
                }
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome-zh",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "better-tabs",
            "props": {
              "rememberPanels": {
                "container": "panel",
                "stack": "panel-body"
              },
              "buttons": [
                {
                  "id": "files",
                  "label": "文件",
                  "icon": "file",
                  "group": "panels",
                  "action": {
                    "type": "panel",
                    "container": "panel",
                    "stack": "panel-body",
                    "target": "files"
                  }
                },
                {
                  "id": "changes",
                  "label": "变更",
                  "icon": "changes",
                  "group": "panels",
                  "action": {
                    "type": "panel",
                    "container": "panel",
                    "stack": "panel-body",
                    "target": "changes"
                  }
                },
                {
                  "id": "prs",
                  "label": "PR",
                  "icon": "mods/branch-pr/icons/pull-request.svg",
                  "group": "panels",
                  "action": {
                    "type": "panel",
                    "container": "panel",
                    "stack": "panel-body",
                    "target": "pull-requests"
                  }
                },
                {
                  "id": "issues",
                  "label": "议题",
                  "icon": "mods/branch-issue/icons/issue.svg",
                  "group": "panels",
                  "action": {
                    "type": "panel",
                    "container": "panel",
                    "stack": "panel-body",
                    "target": "linear-issues"
                  }
                },
                {
                  "id": "browser",
                  "label": "浏览",
                  "icon": "mods/better-changes/icons/tree.svg",
                  "group": "panels",
                  "action": {
                    "type": "panel",
                    "container": "panel",
                    "stack": "panel-body",
                    "target": "browser"
                  }
                }
              ]
            }
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "herdr-nvim-header",
                      "props": {
                        "replaces": {
                          "mod": "pane-zh"
                        }
                      }
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 10,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "herdr-nvim",
                        "props": {
                          "replaces": {
                            "mod": "files-zh"
                          },
                          "panel_width_was": {
                            "px": 368
                          },
                          "panel_width": 300
                        }
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "better-changes"
                      }
                    },
                    {
                      "id": "pull-requests",
                      "type": "block",
                      "content": {
                        "mod": "branch-pr"
                      }
                    },
                    {
                      "id": "linear-issues",
                      "type": "block",
                      "content": {
                        "mod": "branch-issue"
                      }
                    },
                    {
                      "id": "browser",
                      "type": "block",
                      "content": {
                        "mod": "better-files"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 300
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "workspace-status-zh"
          },
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "toast": "toast-zh",
  "terminal_menu": "menu-zh",
  "floating": [
    {
      "id": "herdr-nvim-sync",
      "content": {
        "mod": "herdr-nvim",
        "props": {
          "role": "sync"
        }
      },
      "edge": "bottom",
      "align": "end"
    }
  ]
}
